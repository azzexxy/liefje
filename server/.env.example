# Copy this file to .env for local testing (never commit the real .env).
# On Render, set these as environment variables in the service dashboard instead.

PORT=3000
NODE_ENV=development

# Long random string used to sign the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Skips Cloudinary + GitHub and just logs/returns what *would* happen.
# Use this for local testing so nothing real gets touched.
DRY_RUN=true

# Comma-separated "username:bcryptHash" pairs, one per person.
# Generate a hash for a password with:
#   npm run hash-password -- "the-real-password"
USERS=jij:REPLACE_WITH_BCRYPT_HASH,zij:REPLACE_WITH_BCRYPT_HASH

# Fine-grained GitHub personal access token, scoped to just this repo,
# with Contents: Read and write permission.
GITHUB_TOKEN=github_pat_xxx
GITHUB_OWNER=azzexxy
GITHUB_REPO=liefje
GITHUB_BRANCH=claude/birthday-website-qr-code-79mlx6
GITHUB_MEMORIES_PATH=assets/data/memories.json

# From your Cloudinary dashboard ("API Environment variable").
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# The origin (scheme + host, no path) the public site is served from — the
# inline "add memory" modal on that site calls this API cross-origin with
# cookies attached, so it must be locked to this exact value.
PUBLIC_SITE_ORIGIN=https://azzexxy.github.io
